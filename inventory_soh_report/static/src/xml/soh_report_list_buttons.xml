<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Inventory SOH Report: buttons right after the title and gear icon -->
    <t t-name="inventory_soh_report.ListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="inside">
            <div class="o_soh_week_actions d-inline-flex align-items-center gap-2 ms-2 d-print-none">
                <button type="button" class="btn btn-primary text-nowrap"
                        t-on-click="onClickUploadPhysicalInventory">
                    Upload Physical Inventory
                </button>
                <button t-if="sohWeek.has_upload" type="button" class="btn btn-secondary text-nowrap"
                        t-att-data-tooltip="sohWeek.name ? sohWeek.name + ' · since ' + sohWeek.start : ''"
                        t-on-click="onClickCloseWeek">
                    Close Week
                </button>
                <button type="button" class="btn btn-secondary text-nowrap"
                        data-tooltip="Open SOH Weekly History"
                        t-on-click="onClickWeeklyHistory">
                    <i class="fa fa-history me-1"/>History
                </button>
            </div>
        </xpath>
    </t>

</templates>
