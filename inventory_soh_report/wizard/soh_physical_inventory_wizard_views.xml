<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_soh_physical_inventory_wizard_form" model="ir.ui.view">
        <field name="name">soh.physical.inventory.wizard.form</field>
        <field name="model">soh.physical.inventory.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Physical Inventory">
                <field name="state" invisible="1"/>
                <field name="week_id" invisible="1"/>
                <field name="download_id" invisible="1"/>

                <div class="alert alert-info mb-3" role="status">
                    <strong><field name="week_name" readonly="1" class="d-inline"/></strong>
                    <span> · started on </span>
                    <field name="week_start" readonly="1" class="d-inline"/>
                </div>

                <h5>1. Download Inventory</h5>
                <p class="text-muted mb-2">
                    An Excel count sheet with SKU, Product, UoM and a yellow
                    Physical Inventory column filled with each product's Ideal SOH.
                    Change only the rows where your count is different. Every filled row
                    is uploaded as the count; a row you clear is skipped.
                </p>
                <button name="action_download" type="object" icon="fa-download"
                        string="Download Inventory" class="btn-primary mb-4"/>

                <h5>2. Upload Inventory</h5>
                <p class="text-muted mb-2">Upload the same file after the count, then check it.</p>
                <group>
                    <field name="upload_file" filename="upload_filename" string="Count File"/>
                    <field name="upload_filename" invisible="1"/>
                </group>
                <button name="action_preview" type="object" icon="fa-search"
                        string="Check File" class="btn-secondary mb-3"
                        invisible="not upload_file"/>

                <div invisible="state != 'preview'">
                    <div class="alert alert-danger" role="alert" invisible="not error_text">
                        <field name="error_text" readonly="1" nolabel="1"/>
                    </div>
                    <div invisible="error_text">
                        <group col="3">
                            <field name="rows_read" readonly="1"/>
                            <field name="rows_changed" readonly="1"/>
                            <field name="rows_unchanged" readonly="1"/>
                            <field name="rows_edited" readonly="1"/>
                        </group>
                        <p class="text-muted" invisible="rows_changed != 0">
                            No Physical Inventory value was filled in this file, so there is nothing to apply.
                        </p>
                        <p class="text-muted" invisible="rows_changed == 0 or rows_edited != 0">
                            No row was changed in the file: every counted product matches its Ideal SOH.
                        </p>
                        <field name="edited_line_ids" readonly="1" nolabel="1" invisible="rows_edited == 0">
                            <list>
                                <field name="product_name" string="Product"/>
                                <field name="uom_name"/>
                                <field name="live_qty" options="{'digits': [16, 3]}"/>
                                <field name="counted_qty" options="{'digits': [16, 3]}"/>
                                <field name="stock_change" options="{'digits': [16, 3]}"
                                       decoration-danger="stock_change &lt; 0"
                                       decoration-success="stock_change &gt; 0"/>
                            </list>
                        </field>
                        <p class="text-muted mt-2" invisible="rows_changed == 0">
                            Nothing changes in Odoo until you confirm. On confirm, the stock
                            of each product above is set to the counted quantity through an
                            inventory adjustment.
                        </p>
                    </div>
                </div>

                <footer>
                    <button name="action_confirm" type="object" string="Confirm Upload"
                            class="btn-primary"
                            invisible="state != 'preview' or error_text or rows_changed == 0"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_soh_physical_inventory_wizard" model="ir.actions.act_window">
        <field name="name">Upload Physical Inventory</field>
        <field name="res_model">soh.physical.inventory.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_soh_physical_inventory_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
