<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Add "Inventory SOH Report" under the existing
        Inventory ▶ Reporting menu group.

        stock.menu_stock_report is the standard Odoo 18
        "Reporting" parent menu inside the Inventory app.
    -->
    <menuitem
        id="menu_inventory_soh_report"
        name="Inventory SOH Report"
        parent="stock.menu_warehouse_report"
        action="action_inventory_soh_report"
        sequence="25"
        groups="stock.group_stock_user"/>

    <!-- SOH Weekly History has no menu entry: it opens from the "History"
         button on the Inventory SOH Report. -->

    <!-- Every physical count upload, including rejected files -->
    <menuitem
        id="menu_soh_upload_log"
        name="SOH Upload Log"
        parent="stock.menu_warehouse_report"
        action="action_soh_upload_log"
        sequence="27"
        groups="stock.group_stock_user"/>

</odoo>
